.art {
    -unity-background-scale-mode: scale-to-fit;
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
}

.onboarding {
    align-items: center;
    justify-content: space-between;
    margin-top: 3%;
    margin-right: 3%;
    margin-bottom: 3%;
    margin-left: 3%;
}

.title {
    -unity-text-align: upper-center;
    -unity-font-definition: url("project://database/Assets/Fonts/Outfit-Bold.ttf?fileID=12800000&guid=009c88122ff54034eba16c07ef9b6b79&type=3#Outfit-Bold");
    color: rgb(4, 8, 19);
    font-size: 80%;
    width: 100%;
    height: 20%;
}

.description {
    -unity-font-definition: url("project://database/Assets/Fonts/Outfit-Regular.ttf?fileID=12800000&guid=fab92155c4946e04989ea5c5828f7daa&type=3#Outfit-Regular");
    font-size: 60%;
    color: rgb(4, 8, 19);
    -unity-text-align: upper-center;
    text-overflow: ellipsis;
    flex-grow: 1;
    margin-top: 3%;
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    width: 100%;
    white-space: pre-wrap;
    height: 30%;
    overflow: hidden;
}

.button-text {
    -unity-font-definition: url("project://database/Assets/Fonts/Outfit-Bold.ttf?fileID=12800000&guid=009c88122ff54034eba16c07ef9b6b79&type=3#Outfit-Bold");
    color: rgb(242, 242, 242);
    font-size: 55%;
    -unity-text-align: middle-center;
    flex-grow: 0;
}

.button {
    flex-direction: row;
    justify-content: center;
    width: 90%;
    background-color: rgb(0, 140, 54);
    padding-top: 30px;
    padding-right: 30px;
    padding-bottom: 30px;
    padding-left: 30px;
    border-top-left-radius: 80px;
    border-top-right-radius: 80px;
    border-bottom-right-radius: 80px;
    border-bottom-left-radius: 80px;
    height: 20%;
    transition-duration: 0.5s;
    margin-top: 5%;
}
