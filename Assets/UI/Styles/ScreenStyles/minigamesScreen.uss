.icon {
    background-image: url("project://database/Assets/Visuals/Icons/game.png?fileID=21300000&guid=f0d24f6588e9107429db780a97b9fb57&type=3#game");
    -unity-background-image-tint-color: rgb(0, 165, 0);
    width: 35%;
    height: 15%;
    -unity-background-scale-mode: scale-to-fit;
}

.title {
    -unity-font-definition: url("project://database/Assets/Fonts/Outfit-Bold.ttf?fileID=12800000&guid=009c88122ff54034eba16c07ef9b6b79&type=3#Outfit-Bold");
    color: rgb(242, 242, 242);
    margin-top: 5%;
    -unity-text-align: middle-center;
    font-size: 120%;
}

.game-selector {
    background-image: url("project://database/Assets/Visuals/Pictures/placeholder.png?fileID=21300000&guid=cc00a14089fbcbc48b1ee5977fc4e8a0&type=3#placeholder");
    width: auto;
    height: 35%;
    margin-top: 5%;
    margin-right: 10%;
    margin-bottom: 5%;
    margin-left: 10%;
    border-top-left-radius: 50px;
    border-top-right-radius: 50px;
    border-bottom-right-radius: 50px;
    border-bottom-left-radius: 50px;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.options {
    width: 100%;
    height: 60%;
    margin-top: 8%;
}

.exit {
    background-image: url("project://database/Assets/Visuals/Icons/exit.png?fileID=21300000&guid=2c69a9bee7278dd44be128b292e9c429&type=3#exit");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(102, 255, 102);
    width: 12%;
    height: 8%;
    position: absolute;
    bottom: 0;
    left: 10%;
}
