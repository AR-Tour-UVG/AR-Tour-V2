.button {
    flex-direction: row;
    background-color: rgb(0, 140, 54);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    justify-content: center;
}

.spacer {
    flex-grow: 2;
}

.left-icon {
    -unity-background-image-tint-color: rgb(4, 8, 19);
    -unity-background-scale-mode: scale-to-fit;
    flex-grow: 1;
    background-position-x: right 0;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
    background-image: none;
}

.container {
    flex-direction: row;
    flex-grow: 1;
}

.btn-text {
    -unity-font-definition: url("project://database/Assets/Fonts/Outfit-Bold.ttf?fileID=12800000&guid=009c88122ff54034eba16c07ef9b6b79&type=3#Outfit-Bold");
    color: rgb(4, 8, 19);
    font-size: 25px;
    -unity-text-align: middle-center;
}

.right-icon {
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    -unity-background-image-tint-color: rgb(4, 8, 19);
    flex-grow: 1;
    -unity-background-scale-mode: scale-to-fit;
    flex-direction: column;
    background-image: none;
    background-position-x: left 0;
}

.button:active {
    background-color: rgb(1, 61, 42);
}

.button:active .btn-text {
    color: rgb(242, 242, 242);
}

.button:active .left-icon {
    -unity-background-image-tint-color: rgb(242, 242, 242);
}

.button:active .right-icon {
    -unity-background-image-tint-color: rgb(242, 242, 242);
}
