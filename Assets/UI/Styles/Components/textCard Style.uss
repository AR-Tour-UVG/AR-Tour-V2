.container {
    margin-top: 15px;
    margin-right: 15px;
    margin-bottom: 15px;
    margin-left: 15px;
    background-image: url("project://database/Assets/Visuals/Backgrounds/Basic/Dark%20Glass.png?fileID=2800000&guid=21c37f3bbba75264281cff8c0c326fd0&type=3#Dark Glass");
    -unity-background-scale-mode: scale-and-crop;
    border-left-color: rgba(255, 255, 255, 0);
    border-right-color: rgba(255, 255, 255, 0);
    border-top-color: rgba(255, 255, 255, 0);
    border-bottom-color: rgba(255, 255, 255, 0);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    justify-content: center;
    align-items: flex-start;
}

.text {
    -unity-font-definition: url("project://database/Assets/Fonts/Outfit-SemiBold.ttf?fileID=12800000&guid=b8a090f2eefc036448c302f364fb6e9d&type=3#Outfit-SemiBold");
    font-size: 28px;
    color: rgb(242, 242, 242);
    -unity-text-align: middle-center;
    white-space: pre-wrap;
    text-overflow: ellipsis;
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
}
