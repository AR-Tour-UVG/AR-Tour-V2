.root {
    width: 100%;
    height: 100%;
    font-size: 110px;
    -unity-font-definition: url("project://database/Assets/Fonts/Outfit-Regular.ttf?fileID=12800000&guid=fab92155c4946e04989ea5c5828f7daa&type=3#Outfit-Regular");
    background-image: url("project://database/Assets/Visuals/Backgrounds/main-gradient.png?fileID=21300000&guid=35a72a99042af26489680096859da0ff&type=3#main-gradient");
}

.top-inset {
    width: 100%;
    height: 7%;
}

.bottom-inset {
    width: 100%;
    height: 4%;
}

.safe-area {
    flex-grow: 1;
    justify-content: flex-start;
    align-items: center;
    margin-top: 5%;
    margin-right: 5%;
    margin-bottom: 5%;
    margin-left: 5%;
}

.dragon {
    background-image: url("project://database/Assets/Visuals/Icons/dragon-color-0.5x.png?fileID=21300000&guid=fef0754821ec7374c97c6ed3baa60dda&type=3#dragon-color-0.5x");
    -unity-background-scale-mode: scale-to-fit;
    width: 400px;
    height: 400px;
    margin-top: 5%;
    margin-right: 5%;
    margin-bottom: 5%;
    margin-left: 5%;
}

.suptitle {
    -unity-font-definition: url("project://database/Assets/Fonts/Outfit-SemiBold.ttf?fileID=12800000&guid=b8a090f2eefc036448c302f364fb6e9d&type=3#Outfit-SemiBold");
    color: rgb(242, 242, 242);
    font-size: 110%;
    -unity-text-align: middle-center;
    text-overflow: ellipsis;
}

.title {
    -unity-font-definition: url("project://database/Assets/Fonts/Outfit-Bold.ttf?fileID=12800000&guid=009c88122ff54034eba16c07ef9b6b79&type=3#Outfit-Bold");
    -unity-text-align: middle-center;
    text-overflow: ellipsis;
    font-size: 150%;
    color: rgb(242, 242, 242);
    -unity-font-style: normal;
}

.options {
    width: 100%;
    margin-top: 15%;
}

.button-text {
    -unity-font-definition: url("project://database/Assets/Fonts/Outfit-Bold.ttf?fileID=12800000&guid=009c88122ff54034eba16c07ef9b6b79&type=3#Outfit-Bold");
    color: rgb(242, 242, 242);
    font-size: 70px;
    -unity-text-align: middle-left;
    flex-grow: 0;
    margin-top: 0%;
    margin-right: 0%;
    margin-bottom: 0%;
    margin-left: 5%;
}

.button-icon {
    flex-grow: 0;
    -unity-background-image-tint-color: rgb(242, 242, 242);
    -unity-background-scale-mode: scale-to-fit;
    background-position-x: right 0;
    width: 120px;
    background-image: none;
}

.button {
    flex-direction: row;
    justify-content: center;
    width: auto;
    background-color: rgb(0, 140, 54);
    padding-top: 30px;
    padding-right: 30px;
    padding-bottom: 30px;
    padding-left: 30px;
    border-top-left-radius: 100px;
    border-top-right-radius: 100px;
    border-bottom-right-radius: 100px;
    border-bottom-left-radius: 100px;
    height: 200px;
    transition-duration: 0.5s;
}

.uvg {
    background-image: url("project://database/Assets/Visuals/Logos/uvg-horizontal.png?fileID=21300000&guid=58e0e6cc65b62594c8790cafca52362d&type=3#uvg-horizontal");
    -unity-background-scale-mode: scale-to-fit;
    flex-direction: column-reverse;
    flex-grow: 0;
    width: 100%;
    height: 160px;
}
