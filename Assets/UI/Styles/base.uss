.base {
    flex-wrap: wrap;
    justify-content: space-between;
    width: 100%;
    height: 100%;
}

.topInset {
    flex-wrap: wrap;
    width: 100%;
    height: 7%;
}

.bottomInset {
    flex-wrap: wrap;
    width: 100%;
    height: 4%;
}

.safeArea {
    flex-shrink: 0;
    flex-grow: 1;
    flex-wrap: wrap;
    width: 100%;
}
