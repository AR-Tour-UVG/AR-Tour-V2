.settings-container {
    width: 76%;
    height: 40%;
    border-top-left-radius: 50px;
    border-top-right-radius: 50px;
    border-bottom-right-radius: 50px;
    border-bottom-left-radius: 50px;
    -unity-background-scale-mode: scale-and-crop;
    padding-top: 5%;
    padding-right: 5%;
    padding-bottom: 5%;
    padding-left: 5%;
    background-image: url("project://database/Assets/Visuals/Backgrounds/modal-gradient.png?fileID=21300000&guid=0754f01599ad749449f83a8c210221c5&type=3#modal-gradient");
}

.top-section {
    align-items: center;
    justify-content: flex-start;
    width: 100%;
    height: 30%;
}

.close-section {
    flex-direction: row-reverse;
    height: 22%;
    width: 100%;
}

.close-icon {
    background-image: url("project://database/Assets/Visuals/Icons/GUI/quit.png?fileID=21300000&guid=601bf6fc0b8767d4cba76eef8704982f&type=3#quit");
    width: 80px;
    -unity-background-image-tint-color: rgb(242, 242, 242);
    height: 70px;
}

.settings-icon {
    background-image: url("project://database/Assets/Visuals/Icons/GUI/settings.png?fileID=21300000&guid=7cb2ad61dfa4890498709492fbe7c2f4&type=3#settings");
    -unity-background-image-tint-color: rgb(242, 242, 242);
    -unity-background-scale-mode: scale-to-fit;
    width: 100px;
    height: 100px;
}

.header {
    flex-grow: 1;
    align-items: center;
    justify-content: space-between;
}

.title {
    -unity-font-definition: url("project://database/Assets/Fonts/FontAssets/Outfit-SemiBold-SDF.asset?fileID=11400000&guid=3ccb137e78966aa49a39850df977b638&type=2#Outfit-SemiBold-SDF");
    color: rgb(242, 242, 242);
    -unity-text-align: middle-center;
    text-overflow: ellipsis;
    font-size: 80%;
}

.options-section {
    flex-grow: 1;
    height: 70%;
    width: 100%;
    align-items: center;
    padding-top: 10%;
    padding-right: 5%;
    padding-bottom: 0%;
    padding-left: 5%;
}

.setting-section {
    align-items: stretch;
    align-self: flex-start;
    height: 50%;
    width: 100%;
}

.setting-title {
    -unity-font-definition: url("project://database/Assets/Fonts/FontAssets/Outfit-SemiBold-SDF.asset?fileID=11400000&guid=3ccb137e78966aa49a39850df977b638&type=2#Outfit-SemiBold-SDF");
    font-size: 50%;
    color: rgb(242, 242, 242);
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
}

.setting-container {
    flex-direction: row;
    padding-top: 5%;
    padding-right: 5%;
    padding-bottom: 5%;
    padding-left: 5%;
    align-items: center;
    justify-content: space-between;
}

.volume-icon {
    width: 100px;
    height: 100px;
    background-image: url("project://database/Assets/Visuals/Icons/GUI/volume-high.png?fileID=21300000&guid=f34f5b64529d769468e5ecd6b8658d14&type=3#volume-high");
    -unity-background-image-tint-color: rgb(242, 242, 242);
    -unity-background-scale-mode: scale-to-fit;
    margin-right: 5%;
}

#Viewport > #SettingsContainer > #Settings > #VolumeSection > #VolumeContainer > #Slider {
    height: 80%;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    flex-grow: 1;
}

#Viewport > #SettingsContainer > #Settings > #VolumeSection > #VolumeContainer > #Slider > .unity-slider__input > #unity-drag-container > #unity-tracker {
    height: 40px;
    position: absolute;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    background-color: rgb(75, 75, 75);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    top: 25%;
    overflow: hidden;
}

#Viewport > #SettingsContainer > #Settings > #VolumeSection > #VolumeContainer > #Slider > .unity-slider__input > #unity-drag-container > #unity-dragger {
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 100%;
    border-top-right-radius: 100%;
    border-bottom-right-radius: 100%;
    border-bottom-left-radius: 100%;
    position: absolute;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    height: 80px;
    width: 80px;
    top: 0%;
    background-color: rgb(242, 242, 242);
}

#Viewport > #SettingsContainer > #Settings > #VolumeSection > #VolumeContainer > #Slider > .unity-slider__input > #unity-drag-container > #unity-tracker > #unity-fill {
    background-color: rgb(0, 165, 0);
}

.font-icon {
    width: 100px;
    height: 100px;
    background-image: url("project://database/Assets/Visuals/Icons/GUI/font-size.png?fileID=21300000&guid=7d5ed9291203c8b42853f7f34f48c4a9&type=3#font-size");
    -unity-background-image-tint-color: rgb(242, 242, 242);
    -unity-background-scale-mode: scale-to-fit;
    margin-right: 5%;
}

.font-size-selector {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    flex-grow: 1;
}

.small-font {
    -unity-text-align: middle-center;
    text-overflow: ellipsis;
    -unity-font-definition: url("project://database/Assets/Fonts/FontAssets/Outfit-Regular-SDF.asset?fileID=11400000&guid=5ca79f15c435d9c468768628c1e23902&type=2#Outfit-Regular-SDF");
    color: rgb(242, 242, 242);
    font-size: 60px;
}

.normal-font {
    -unity-font-definition: url("project://database/Assets/Fonts/FontAssets/Outfit-Regular-SDF.asset?fileID=11400000&guid=5ca79f15c435d9c468768628c1e23902&type=2#Outfit-Regular-SDF");
    color: rgb(242, 242, 242);
    -unity-text-align: middle-center;
    font-size: 75px;
}

.large-font {
    font-size: 90px;
    -unity-font-definition: url("project://database/Assets/Fonts/TTF/Outfit-Regular.ttf?fileID=12800000&guid=fab92155c4946e04989ea5c5828f7daa&type=3#Outfit-Regular");
    -unity-text-align: middle-center;
    color: rgb(242, 242, 242);
}

.font-option {
    background-color: rgb(75, 75, 75);
    height: 80%;
    width: 30%;
    align-items: center;
    justify-content: center;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    padding-top: 2%;
    padding-right: 2%;
    padding-bottom: 2%;
    padding-left: 2%;
}

.font-option.selected {
    background-color: rgb(0, 165, 0);
}

.volume-icon.mute {
    background-image: url("project://database/Assets/Visuals/Icons/GUI/volume-muted.png?fileID=21300000&guid=f5fc26fff75699a45ae4aac75100e607&type=3#volume-muted");
    -unity-background-image-tint-color: rgb(242, 242, 242);
}

.volume-icon.low {
    background-image: url("project://database/Assets/Visuals/Icons/GUI/volume-low.png?fileID=21300000&guid=232da3a3714390a4192ee885e8e77944&type=3#volume-low");
    -unity-background-image-tint-color: rgb(242, 242, 242);
}

.volume-icon.med {
    background-image: url("project://database/Assets/Visuals/Icons/GUI/volume-mid.png?fileID=21300000&guid=2644a0d89a8f9bc49898ef9dd66dffa3&type=3#volume-mid");
    -unity-background-image-tint-color: rgb(242, 242, 242);
}

.volume-icon.high {
    background-image: url("project://database/Assets/Visuals/Icons/GUI/volume-high.png?fileID=21300000&guid=f34f5b64529d769468e5ecd6b8658d14&type=3#volume-high");
    -unity-background-image-tint-color: rgb(242, 242, 242);
}

#SettingsContainer {
    scale: 0.5 0.5;
    opacity: 0;
    transition-property: scale, opacity;
    transition-duration: 250ms, 250ms;
    transition-timing-function: ease-in-out, ease-in-out;
}

#SettingsContainer.is-open {
    scale: 1 1;
    opacity: 1;
}
