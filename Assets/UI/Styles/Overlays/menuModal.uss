.menu-container {
    background-image: url("project://database/Assets/Visuals/Backgrounds/horizontal-gradient.png?fileID=21300000&guid=8bfebf6f2fa1afb4cb37b64ef112da1e&type=3#horizontal-gradient");
    width: 80%;
    height: 100%;
    position: absolute;
    top: 0;
    right: 0;
    padding-top: 10%;
    padding-right: 10%;
    padding-bottom: 10%;
    padding-left: 10%;
    -unity-background-scale-mode: stretch-to-fill;
}

.option-text {
    -unity-font-definition: url("project://database/Assets/Fonts/FontAssets/Outfit-SemiBold-SDF.asset?fileID=11400000&guid=3ccb137e78966aa49a39850df977b638&type=2#Outfit-SemiBold-SDF");
    color: rgb(242, 242, 242);
    -unity-text-align: middle-left;
    font-size: 80%;
    padding-top: 2%;
    padding-right: 2%;
    padding-bottom: 2%;
    padding-left: 2%;
    margin-left: 5%;
}

.option-icon {
    width: 100px;
    height: 100px;
}

.close-icon {
    width: 120px;
    height: 100px;
    background-image: url("project://database/Assets/Visuals/Icons/GUI/quit.png?fileID=21300000&guid=601bf6fc0b8767d4cba76eef8704982f&type=3#quit");
    -unity-background-image-tint-color: rgb(242, 242, 242);
}

.top-section {
    width: 100%;
    height: 5%;
    align-items: flex-end;
    justify-content: center;
}

.options-container {
    align-items: flex-start;
    margin-top: 20%;
    width: 100%;
    height: 40%;
    justify-content: space-around;
}

.option {
    width: 100%;
    flex-direction: row;
    align-items: center;
}

.separator {
    background-color: rgb(242, 242, 242);
    width: 100%;
    height: 0.5%;
}
