.art {
    -unity-background-scale-mode: scale-to-fit;
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
}

.onboarding {
    align-items: center;
    justify-content: space-between;
    margin-top: 3%;
    margin-right: 3%;
    margin-bottom: 3%;
    margin-left: 3%;
}

.title {
    -unity-text-align: upper-center;
    -unity-font-definition: url("project://database/Assets/Fonts/Font%20Assets/Outfit-Bold%20SDF.asset?fileID=11400000&guid=95ce5fb5eb91d2647b6aa52c09e3bc8c&type=2#Outfit-Bold SDF");
    color: rgb(4, 8, 19);
    font-size: 80%;
    width: 100%;
    height: 20%;
}

.description {
    -unity-font-definition: url("project://database/Assets/Fonts/Font%20Assets/Outfit-Regular%20SDF.asset?fileID=11400000&guid=5ca79f15c435d9c468768628c1e23902&type=2#Outfit-Regular SDF");
    font-size: 60%;
    color: rgb(4, 8, 19);
    -unity-text-align: upper-center;
    text-overflow: ellipsis;
    flex-grow: 1;
    margin-top: 3%;
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    width: 100%;
    white-space: pre-wrap;
    height: 30%;
    overflow: hidden;
}

.button-text {
    -unity-font-definition: url("project://database/Assets/Fonts/Font%20Assets/Outfit-Bold%20SDF.asset?fileID=11400000&guid=95ce5fb5eb91d2647b6aa52c09e3bc8c&type=2#Outfit-Bold SDF");
    color: rgb(242, 242, 242);
    font-size: 55%;
    -unity-text-align: middle-center;
    flex-grow: 0;
}

.button {
    flex-direction: row;
    justify-content: center;
    width: 90%;
    background-color: rgb(0, 140, 54);
    padding-top: 30px;
    padding-right: 30px;
    padding-bottom: 30px;
    padding-left: 30px;
    border-top-left-radius: 80px;
    border-top-right-radius: 80px;
    border-bottom-right-radius: 80px;
    border-bottom-left-radius: 80px;
    height: 20%;
    transition-duration: 0.5s;
    margin-top: 5%;
}
