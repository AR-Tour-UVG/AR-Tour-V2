<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/Overlays/settingsModal.uss?fileID=7433441132597879392&amp;guid=17eeca038a79fb649a099d253fe1a95b&amp;type=3" />
    <Style src="project://database/Assets/UI/Styles/baseLayout.uss?fileID=7433441132597879392&amp;guid=28ac6e247c5360949b32cbce032f8d7e&amp;type=3" />
    <ui:VisualElement name="Viewport" class="root" style="align-items: center; justify-content: center; background-image: url(&quot;project://database/Assets/Visuals/Backgrounds/dark-glass.png?fileID=21300000&amp;guid=21c37f3bbba75264281cff8c0c326fd0&amp;type=3#dark-glass&quot;);">
        <ui:VisualElement name="SettingsContainer" class="settings-container">
            <ui:VisualElement name="TopSection" class="top-section">
                <ui:VisualElement name="CloseSection" class="close-section">
                    <ui:VisualElement name="CloseIcon" class="close-icon" />
                </ui:VisualElement>
                <ui:VisualElement name="Header" class="header">
                    <ui:VisualElement name="SettingsIcon" class="settings-icon" />
                    <ui:Label text="Preferencias" name="Title" class="title" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="Settings" class="options-section">
                <ui:VisualElement name="VolumeSection" class="setting-section">
                    <ui:Label text="Volumen de Jack" name="VolumeTitle" class="setting-title" />
                    <ui:VisualElement name="VolumeContainer" class="setting-container">
                        <ui:VisualElement name="VolumeIcon" class="volume-icon" />
                        <ui:Slider enabled="true" value="5" name="Slider" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="FontSection" class="setting-section">
                    <ui:Label text="Tamaño de Letra" name="FontTitle" class="setting-title" />
                    <ui:VisualElement name="FontContainer" class="setting-container">
                        <ui:VisualElement name="FontIcon" class="font-icon" />
                        <ui:VisualElement name="FontSizeSelector" class="font-size-selector">
                            <ui:VisualElement name="Small" class="font-option">
                                <ui:Label text="Aa" name="SmallFont" class="small-font" />
                            </ui:VisualElement>
                            <ui:VisualElement name="Normal" class="font-option">
                                <ui:Label text="Aa" name="NormalFont" class="normal-font" />
                            </ui:VisualElement>
                            <ui:VisualElement name="Large" class="font-option">
                                <ui:Label text="Aa" name="LargeFont" class="large-font" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
