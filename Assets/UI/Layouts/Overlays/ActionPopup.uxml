    <ui:VisualElement name="Viewport" class="root" style="align-items: center; justify-content: center; background-image: url(&quot;project://database/Assets/Visuals/Backgrounds/dark-glass.png?fileID=21300000&amp;guid=21c37f3bbba75264281cff8c0c326fd0&amp;type=3#dark-glass&quot;); -unity-background-image-tint-color: rgba(255, 255, 255, 0.59);">
