    <ui:VisualElement name="Viewport" class="root" style="background-image: url(&quot;project://database/Assets/Visuals/Pictures/Biblioteca.png?fileID=21300000&amp;guid=d521ff3d11eaa274a915e28d03c9666d&amp;type=3#Biblioteca&quot;);">
