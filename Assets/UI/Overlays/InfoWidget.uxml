            <ui:VisualElement name="HeaderSpace" class="header" />
            <ui:VisualElement name="InfoWidget" class="widget">
                <ui:VisualElement name="WidgetContainer" class="widget-container">
                    <ui:VisualElement name="AreaImage" class="area-image" />
                    <ui:ScrollView horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" class="info-container">
                        <ui:Label text="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Aliquam mauris mi, ultrices sit amet fringilla at, feugiat vitae velit. Praesent ultrices diam elit, vel dictum nibh euismod sed. Maecenas feugiat turpis massa, porta aliquam diam pharetra vel. Phasellus aliquam orci sit amet urna ultrices sollicitudin. Donec nulla eros, accumsan et urna vitae, tincidunt tempus ligula. Sed dapibus orci vel magna sodales, in consectetur massa venenatis. Suspendisse faucibus magna et eros sodales pretium. Suspendisse vehicula interdum velit ut imperdiet. Donec tortor magna, efficitur ac tortor sit amet, luctus gravida libero. Phasellus eget aliquam magna. Proin ullamcorper at elit ac tristique." name="Description" class="area-description" style="-unity-text-align: upper-center; white-space: normal;" />
                    </ui:ScrollView>
                    <ui:VisualElement name="ContinueButton" class="continue-button">
                        <ui:Label text="Ir al Siguiente" name="ButtonText" class="continue-text" />
                        <ui:VisualElement name="ArrowIcon" class="continue-icon" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="Jack" class="peeking-jack" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="BottomInset" class="bottom-inset" />
    </ui:VisualElement>
</ui:UXML>
