<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="main-menu" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Minijuegos/Sprites/Trivia/Background.png?fileID=2800000&amp;guid=37cda2cfcd01e3e478f533cd970c9e27&amp;type=3#Background&quot;);">
        <ui:VisualElement name="Header" style="flex-grow: 1; align-items: center;">
            <ui:VisualElement name="logoTrivia" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/Minijuegos/Sprites/Trivia/TriviaUVG.png?fileID=2800000&amp;guid=ba63188e8b28c51458f09f791ab4d67d&amp;type=3#TriviaUVG&quot;); width: 85px; height: 85px; flex-shrink: 0;" />
            <ui:VisualElement name="iconos" style="flex-grow: 0; flex-shrink: 0; flex-direction: row;">
                <ui:VisualElement name="Score" style="flex-grow: 1; flex-direction: row; align-items: center; margin-right: 10px;">
                    <ui:VisualElement name="ScoreImage" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/Minijuegos/Sprites/Trivia/moneda.png?fileID=2800000&amp;guid=96ffa3a4f97694643823d0a8fa49a895&amp;type=3#moneda&quot;); -unity-background-scale-mode: stretch-to-fill; width: 30px; height: 30px; flex-shrink: 0;" />
                    <ui:Label text="0" name="ScoreText" style="-unity-font-definition: resource(&apos;UI Toolkit/Fonts/TTF/Outfit-Bold&apos;); font-size: 50px; -unity-text-align: upper-left;" />
                </ui:VisualElement>
                <ui:VisualElement name="Streak" style="flex-grow: 1; flex-direction: row; align-items: center;">
                    <ui:VisualElement name="StreakImage" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/Minijuegos/Sprites/Trivia/fuego.png?fileID=2800000&amp;guid=95601974537b9fd4aad159144dd59911&amp;type=3#fuego&quot;); flex-shrink: 0; width: 30px; height: 30px;" />
                    <ui:Label text="0" name="StreakText" style="font-size: 50px; -unity-font-definition: resource(&apos;UI Toolkit/Fonts/TTF/Outfit-Bold&apos;);" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="categories-container" style="flex-grow: 1;" />
        <ui:VisualElement name="StartPanel" style="flex-grow: 1;">
            <ui:Button text="Sortear" name="SortButton" style="border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; background-color: rgb(21, 21, 21); color: rgb(129, 209, 180); -unity-font-definition: resource(&apos;UI Toolkit/Fonts/TTF/Outfit-Bold&apos;); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
            <ui:Button text="Regresar" name="back-button" style="border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; background-color: rgb(21, 21, 21); color: rgb(129, 209, 180); -unity-font-definition: resource(&apos;UI Toolkit/Fonts/TTF/Outfit-Bold&apos;); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="question-menu" style="flex-grow: 1; visibility: visible; display: none; background-image: url(&quot;project://database/Assets/Minijuegos/Sprites/Trivia/Background.png?fileID=2800000&amp;guid=37cda2cfcd01e3e478f533cd970c9e27&amp;type=3#Background&quot;); padding: 15px; justify-content: flex-start;">
        <ui:VisualElement name="Header" style="flex-grow: 0; flex-shrink: 0; height: 50px; justify-content: center; align-items: center; margin-top: 10px; margin-bottom: 15px;">
            <ui:Label text="CATEGORÍA" name="nombre-categoria" style="background-color: rgb(236, 234, 245); border-radius: 15px; padding: 12px 30px; font-size: 20px; -unity-font-style: bold; -unity-text-align: middle-center; width: 70%; color: rgb(0, 0, 0);" />
        </ui:VisualElement>
        <ui:Label text="¿Pregunta de ejemplo?" name="pregunta" style="background-color: rgba(220, 220, 220, 0.9); border-radius: 20px; padding: 18px; font-size: 15px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal; min-height: 80px; max-height: 150px; margin-bottom: 20px; color: rgb(0, 0, 0); align-self: center; width: 88%;" />
        <ui:VisualElement name="respuestas" style="flex-grow: 1; justify-content: space-evenly; align-items: center; padding-top: 10px; padding-bottom: 20px;">
            <ui:Button text="Respuesta 1" name="respuesta-1" style="width: 85%; height: 45px; min-height: 30px; max-height: 75px; background-color: rgb(236, 234, 245); border-radius: 18px; font-size: 16px; -unity-font-style: normal; -unity-text-align: middle-center; border-width: 0; white-space: normal; padding: 12px 15px; color: rgb(0, 0, 0);" />
            <ui:Button text="Respuesta 2" name="respuesta-2" style="width: 85%; height: 45px; min-height: 30px; max-height: 75px; background-color: rgb(236, 234, 245); border-radius: 18px; font-size: 16px; -unity-font-style: normal; -unity-text-align: middle-center; border-width: 0; white-space: normal; padding: 12px 15px; color: rgb(0, 0, 0);" />
            <ui:Button text="Respuesta 3" name="respuesta-3" style="width: 85%; height: 45px; min-height: 30px; max-height: 75px; background-color: rgb(236, 234, 245); border-radius: 18px; font-size: 16px; -unity-font-style: normal; -unity-text-align: middle-center; border-width: 0; white-space: normal; padding: 12px 15px; color: rgb(0, 0, 0);" />
            <ui:Button text="Respuesta 4" name="respuesta-4" style="width: 85%; height: 45px; min-height: 30px; max-height: 75px; background-color: rgb(236, 234, 245); border-radius: 18px; font-size: 16px; -unity-font-style: normal; -unity-text-align: middle-center; border-width: 0; white-space: normal; padding: 12px 15px; color: rgb(0, 0, 0);" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
