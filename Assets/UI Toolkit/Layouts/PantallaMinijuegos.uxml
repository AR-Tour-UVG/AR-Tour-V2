<engine:UXML xmlns:ui="UnityEngine.UIElements" xmlns:engine="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="ContenedorPantallaMinijuegos" style="flex-grow: 1; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; align-items: center; align-self: auto; justify-content: center; background-image: resource(&apos;ImagenesUI/Backgrounds/overlay_pantalla_inicio&apos;); background-color: rgb(255, 255, 255);">
        <ui:VisualElement name="ContenedorMinijuegos" style="flex-grow: 1; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 10px; padding-right: 10px; padding-bottom: 0; padding-left: 10px; align-items: center; align-self: auto; justify-content: center; width: 100%; height: 100%;">
            <ui:Label text="Minijuegos" name="TextoMiniuegos" style="align-items: stretch; align-self: center; -unity-font-definition: resource(&apos;UI Toolkit/Fonts/TTF/Outfit-Bold&apos;); font-size: 25px; color: rgb(255, 255, 255); width: 100%; -unity-text-align: upper-center; background-color: rgba(255, 255, 255, 0);" />
            <ui:Button name="boton_breakout" style="background-image: resource(&apos;ImagenesUI/Backgrounds/breakout_background&apos;); height: 100px; margin-bottom: 10px; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; width: 200px;" />
            <ui:Button name="boton_flappy" style="background-image: resource(&apos;ImagenesUI/Backgrounds/flappyjack_background&apos;); height: 100px; margin-bottom: 10px; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; width: 200px;" />
            <ui:Button name="boton_trivia" style="background-image: resource(&apos;ImagenesUI/Backgrounds/trivia_background&apos;); height: 100px; margin-bottom: 0; padding-bottom: 0; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; width: 200px;" />
            <ui:Button name="boton_volver" text="Regresar" style="-unity-font-definition: resource(&apos;UI Toolkit/Fonts/TTF/Outfit-Bold&apos;); background-color: rgb(0, 165, 119); color: rgb(255, 255, 255); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); font-size: 10px; width: 25%; align-items: center; margin-bottom: 2px; margin-top: 20px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</engine:UXML>
